{
  "version": 2,
  "buildCommand": "echo 'Building Go application'",
  "installCommand": "echo 'No npm dependencies'",
  "framework": null,
  "builds": [
    {
      "use": "@vercel/go",
      "src": "api/client.go",
      "config": {
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/client"
    }
  ]
}